# ───────────── Database ─────────────
# Primary: Supabase (use the SERVICE ROLE key – server only, never NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SECRET=[REDACTED]
# Optional: force driver ("supabase" | "postgres"). Auto-detected when empty.
DB_DRIVER=
# Fallback for local dev / sandbox only (used when Supabase vars are empty)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ───────────── Facebook / Messenger ─────────────
FB_PAGE_ID=
SECRET=[REDACTED]
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v21.0
FB_GRAPH_BASE_URL=https://graph.facebook.com
# Keep "true" in production. "false" only for local curl testing.
FB_VERIFY_SIGNATURE=true
# Message splitting / typing behaviour
FB_MAX_CHUNK_CHARS=280
FB_MAX_LINES_PER_BUBBLE=2
FB_MAX_BUBBLES=3
FB_TYPING_INDICATOR=true
FB_TYPING_DELAY_BASE_MS=400
FB_TYPING_DELAY_PER_CHAR_MS=25
FB_MAX_TYPING_DELAY_MS=2200
FB_MARK_SEEN=true

# ───────────── AI Provider ─────────────
# openrouter | openai | gemini | anthropic | custom
AI_PROVIDER=openrouter
AI_DEFAULT_MODEL=google/gemini-2.0-flash-001
AI_FALLBACK_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.6
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_STEPS=6
AI_HISTORY_LIMIT=12
AI_TIMEOUT_MS=40000

API_KEY=[REDACTED]
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=BikriBot

# Only needed if AI_PROVIDER is switched (model names then use that provider's own IDs, e.g. gpt-4o-mini)
API_KEY=[REDACTED]
API_KEY=[REDACTED]
API_KEY=[REDACTED]
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# ───────────── App ─────────────
# Protects /api/admin/* and /api/chat. Use a long random string.
SECRET=[REDACTED]
DEFAULT_SHOP_NAME=আমাদের শপ
CURRENCY_SYMBOL=৳
